{
  "model_type": "ONNX",
  "npu_mode": "NPU2",
  "quant": {
    "input_configs": [{
      "tensor_name": "images",
      "calibration_dataset": "datasets/train.tar",
      "calibration_size": 50,
      "calibration_mean": [0, 0, 0],
      "calibration_std": [255.0, 255.0, 255.0]
    }],
    "calibration_method": "MinMax",
    "precision_analysis": true,
    "precision_analysis_method": "EndToEnd"
  },
  "input_processors": [{
    "tensor_name": "images",
    "tensor_format": "RGB",
    "tensor_layout": "NCHW",
    "src_format": "RGB",
    "src_dtype": "U8",
    "src_layout": "NHWC",
    "csc_mode": "NoCSC"
  }],
  "output_processors": [
    {"tensor_name": "/model.23/Concat_output_0", "dst_perm": [0, 2, 3, 1]},
    {"tensor_name": "/model.23/Concat_1_output_0", "dst_perm": [0, 2, 3, 1]},
    {"tensor_name": "/model.23/Concat_2_output_0", "dst_perm": [0, 2, 3, 1]}
  ],
  "compiler": {
    "check": 3,
    "check_mode": "CheckOutput",
    "check_cosine_simularity": 0.9
  }
}
